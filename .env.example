# Strava API (required for activity sync)
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
STRAVA_REFRESH_TOKEN=your_strava_refresh_token

# Anthropic API (required for AI coaching)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Hevy API (optional — only for /push-workouts)
HEVY_API_KEY=

# Data directory (Railway: use /data, local: use ./local_data)
DATA_DIR=/data

# App secret (set any random string)
APP_SECRET=change_me_to_something_random