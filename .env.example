# Intervals.icu API (required for activity sync)
INTERVALS_ATHLETE_ID=iXXXXXX
INTERVALS_API_KEY=your_intervals_api_key

# Strava API (legacy — optional if using Intervals.icu)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# Anthropic API (required for AI coaching)
ANTHROPIC_API_KEY=your_anthropic_api_key
# Optional: custom base URL (e.g. https://app.claude.gg)
ANTHROPIC_BASE_URL=
# Optional: override model (default: claude-opus-4-5)
ANTHROPIC_MODEL=claude-opus-4-5

# Hevy API (optional — only for /push-workouts)
HEVY_API_KEY=

# Data directory (Railway: use /data, local: use ./local_data)
DATA_DIR=/data

# App secret (set any random string)
APP_SECRET=change_me_to_something_random